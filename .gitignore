# Python and local tooling
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.vscode/
.pytest_cache/
.ruff_cache/
*.log
*.out
*.bak*

# Isaac Lab installations are external SDKs, not repository sources.
IsaacLab/
IsaacLab-3.0/

# Training outputs and experiment logs
/checkpoints
/logs
/wandb
/amp_data
/outputs
/videos
/recordings
/cache
/tmp
/*.npz
/*.mp4
/*.pt
*.npz
*.mp4
*.pt

# Local robot assets and unified motion data are provisioned separately. Keep
# only the documented directory skeleton in Git; never publish the asset files.
/robo_newton/robolab/data/**
!/robo_newton/robolab/data/README.md
!/robo_newton/robolab/data/robots/
!/robo_newton/robolab/data/robots/rp1/
!/robo_newton/robolab/data/robots/rp1/.gitkeep
