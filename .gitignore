# Tests are kept for local validation but are not part of the public checkout.
**/tests/
**/test_*.py
**/*_test.py

# Host-local experiment scripts and notes are not repository sources.
/project_ops/

# Local package metadata.
/robo_newton/*.egg-info/

# Archived source trees and old Git metadata
archives/
