!/robo_newton/robolab/data/robots/rpo/mjcf/.gitkeep
!/robo_newton/robolab/data/robots/rpo/meshes/
!/robo_newton/robolab/data/robots/rpo/meshes/.gitkeep
!/robo_newton/robolab/data/robots/rpo/terrain_assets/
!/robo_newton/robolab/data/robots/rpo/terrain_assets/.gitkeep
!/robo_newton/robolab/data/motions/
!/robo_newton/robolab/data/motions/newton/
!/robo_newton/robolab/data/motions/newton/rp1/
!/robo_newton/robolab/data/motions/newton/rp1/.gitkeep
!/robo_newton/robolab/data/motions/newton/rpo/
