!/robo_newton/robolab/data/robots/rp1/terrain_assets/
!/robo_newton/robolab/data/robots/rp1/terrain_assets/.gitkeep
!/robo_newton/robolab/data/robots/rpo/
!/robo_newton/robolab/data/robots/rpo/.gitkeep
!/robo_newton/robolab/data/robots/rpo/urdf/
!/robo_newton/robolab/data/robots/rpo/urdf/.gitkeep
